[Unit]
Description=PiCamera MJPEG server (rpicam-vid -> :8000)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=adhi
WorkingDirectory=/home/adhi
ExecStart=/usr/bin/python3 /home/adhi/mjpeg-server.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
